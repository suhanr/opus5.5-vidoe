{
  "title": "The Last Time",
  "voices": { "A": { "voice": "af_heart", "speed": 0.86 } },
  "lead_in": 0.5,
  "end_card": 3.2,
  "lines": [
    { "id": "hook",     "text": "Nobody tells you this.", "pause": 0.6 },
    { "id": "carry1",   "text": "One day, your mom picked you up,", "pause": 0.2 },
    { "id": "carry2",   "text": "put you down,", "pause": 0.25 },
    { "id": "carry3",   "text": "and never picked you up again.", "pause": 0.5 },
    { "id": "knew",     "text": "Neither of you knew it was the last time.", "pause": 0.7 },
    { "id": "play",     "text": "The last time you played outside until the streetlights came on.", "pause": 0.45 },
    { "id": "announce", "text": "Life never announces its last times.", "pause": 0.6 },
    { "id": "call",     "text": "So when Mom calls, pick up.", "pause": 0.5 },
    { "id": "hug",      "text": "Hug a little longer.", "pause": 0.7 },
    { "id": "end1",     "text": "Because one day, it will be the last time.", "pause": 0.6 },
    { "id": "end2",     "text": "And you won't know.", "pause": 0.0 }
  ],
